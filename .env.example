# Financy — Configuration
# Copiez ce fichier en .env et adaptez les valeurs.

# Mot de passe d'accès (vide = pas d'authentification)
# FINANCY_PASSWORD=

# Clé secrète Flask pour les sessions (min. 32 car. ; générée aléatoirement si absente)
# SECRET_KEY=change-me-in-production

# Chemin vers la base de données (défaut : patrimoine.db dans le dossier du projet)
# DB_PATH=patrimoine.db

# Port du serveur (défaut : 5017)
# PORT=5017

# Derrière un reverse proxy : ses adresses ou son réseau, séparés par des
# virgules. L'adresse du client est alors lue dans X-Forwarded-For (limite des
# tentatives de connexion par client). Vide : l'adresse de la connexion.
# FINANCY_PROXIES_DE_CONFIANCE=10.0.0.0/24

# Identite transmise par le reverse proxy (Authelia) : en-tete Remote-User, lu
# seulement depuis FINANCY_PROXIES_DE_CONFIANCE. Le mot de passe reste en repli.
# FINANCY_AUTH_PAR_PROXY=1
# FINANCY_URL_DECONNEXION=https://auth.exemple.fr/logout

# Durée de session en minutes (défaut : 60)
# SESSION_TIMEOUT_MINUTES=60

# Environnement (production désactive le debug et active Secure cookies)
# FLASK_ENV=production

# Provider de cours de marché (mock désactive tout appel réseau)
# Par défaut : yahoo. Utile pour tests / mode démo.
# PRICE_PROVIDER=yahoo

# Scheduler APScheduler — refresh quotidien automatique des cours
# (sinon refresh manuel uniquement via l'onglet Outils)
# SCHEDULER_ENABLED=false
# SCHEDULER_HOUR=21
# SCHEDULER_MINUTE=5
# SCHEDULER_TZ=Europe/Paris

# Conseil patrimonial (advisor)
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ADVISOR_MODEL=claude-sonnet-4-6     # claude-sonnet-4-6 | claude-haiku-4-5 | claude-opus-4-7
# ADVISOR_LLM_PROVIDER=mock           # mock = pas d'appel reseau (tests, demo)
# ADVISOR_BUDGET_USD=5                # alerte si depasse ce budget mensuel
